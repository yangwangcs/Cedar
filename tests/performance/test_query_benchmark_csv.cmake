if(NOT DEFINED CEDAR_BENCHMARK)
  message(FATAL_ERROR "CEDAR_BENCHMARK is required")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789 TOKEN)
set(OPERATIONS
  state-at history events changes expand-out expand-in expand-both
  property-filter temporal-aggregate interval-join k-hop
  coexisting-shortest-path earliest-arrival latest-departure fastest-duration)
foreach(OP ${OPERATIONS})
  set(DB "/tmp/cedar-query-bench-${TOKEN}-${OP}")
  set(EXTRA "")
  execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${DB}" "--operation=${OP}" "--degree=1" "--selectivity-percent=1" "--readers=1" "--cache-state=cold" "--duration-seconds=1" "--reopen-verify=true" ${EXTRA} RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "query benchmark ${OP} failed: ${ERR}\n${OUT}")
  endif()
  string(REPLACE "\n" ";" LINES "${OUT}")
  list(GET LINES 0 HEADER)
  list(GET LINES 1 ROW)
  string(REPLACE "," ";" HEADER_FIELDS "${HEADER}")
  string(REPLACE "," ";" ROW_FIELDS "${ROW}")
  foreach(REQUIRED transactions_per_second query_qps rows_per_second
          query_physical_bytes query_bytes_complete reopen_verified
          terminal_status hard_gate_pass rows)
    list(FIND HEADER_FIELDS "${REQUIRED}" REQUIRED_INDEX)
    if(REQUIRED_INDEX LESS 0)
      message(FATAL_ERROR "CSV missing ${REQUIRED}: ${HEADER}")
    endif()
  endforeach()
  list(FIND HEADER_FIELDS rows ROW_INDEX)
  list(GET ROW_FIELDS ${ROW_INDEX} ROWS_VALUE)
  if(NOT ROWS_VALUE MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CSV rows must be nonzero for ${OP}: ${ROW}")
  endif()
  list(FIND HEADER_FIELDS terminal_status STATUS_INDEX)
  list(GET ROW_FIELDS ${STATUS_INDEX} STATUS_VALUE)
  string(REPLACE "\"" "" STATUS_VALUE "${STATUS_VALUE}")
  if(NOT STATUS_VALUE STREQUAL "OK")
    message(FATAL_ERROR "CSV terminal_status failed for ${OP}: ${ROW}")
  endif()
  list(FIND HEADER_FIELDS reopen_verified REOPEN_INDEX)
  list(GET ROW_FIELDS ${REOPEN_INDEX} REOPEN_VALUE)
  if(NOT REOPEN_VALUE STREQUAL "true")
    message(FATAL_ERROR "CSV reopen verification failed for ${OP}: ${ROW}")
  endif()
  list(FIND HEADER_FIELDS hard_gate_pass GATE_INDEX)
  list(GET ROW_FIELDS ${GATE_INDEX} GATE_VALUE)
  if(NOT GATE_VALUE STREQUAL "true")
    message(FATAL_ERROR "CSV hard gate failed for ${OP}: ${ROW}")
  endif()
endforeach()

set(ACTIVE_DB "/tmp/cedar-query-bench-${TOKEN}-active")
execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${ACTIVE_DB}" "--operation=expand-out" "--projection-work=active" "--duration-seconds=1" OUTPUT_VARIABLE ACTIVE_OUT ERROR_VARIABLE ACTIVE_ERR RESULT_VARIABLE ACTIVE_RC)
if(NOT ACTIVE_RC EQUAL 0)
  message(FATAL_ERROR "active projection benchmark failed: ${ACTIVE_ERR}\n${ACTIVE_OUT}")
endif()
string(REPLACE "\n" ";" ACTIVE_LINES "${ACTIVE_OUT}")
list(GET ACTIVE_LINES 0 ACTIVE_HEADER)
list(GET ACTIVE_LINES 1 ACTIVE_ROW)
string(REPLACE "," ";" ACTIVE_HEADER_FIELDS "${ACTIVE_HEADER}")
string(REPLACE "," ";" ACTIVE_ROW_FIELDS "${ACTIVE_ROW}")
list(FIND ACTIVE_HEADER_FIELDS maintenance_status ACTIVE_STATUS_INDEX)
list(GET ACTIVE_ROW_FIELDS ${ACTIVE_STATUS_INDEX} ACTIVE_STATUS)
string(REPLACE "\"" "" ACTIVE_STATUS "${ACTIVE_STATUS}")
list(FIND ACTIVE_HEADER_FIELDS maintenance_observed ACTIVE_OBSERVED_INDEX)
list(GET ACTIVE_ROW_FIELDS ${ACTIVE_OBSERVED_INDEX} ACTIVE_OBSERVED)
if(NOT ACTIVE_STATUS STREQUAL "refresh-complete" OR NOT ACTIVE_OBSERVED STREQUAL "true")
  message(FATAL_ERROR "active projection maintenance contract failed: ${ACTIVE_ROW}")
endif()
if(NOT EXISTS "${ACTIVE_DB}/projections/generation-1.cstats")
  message(FATAL_ERROR "active projection statistics generation was not persisted")
endif()

# A path containing CSV/JSON delimiters must remain one field and valid JSON.
set(ESCAPED_DB "/tmp/cedar-query-bench-${TOKEN},quote\"path")
execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${ESCAPED_DB}"
  "--operation=state-at" "--duration-seconds=1" "--reopen-verify=true"
  OUTPUT_VARIABLE ESCAPED_OUT ERROR_VARIABLE ESCAPED_JSON RESULT_VARIABLE ESCAPED_RC)
if(NOT ESCAPED_RC EQUAL 0)
  message(FATAL_ERROR "escaped path benchmark failed: ${ESCAPED_JSON}\n${ESCAPED_OUT}")
endif()
string(REPLACE "\n" ";" ESCAPED_LINES "${ESCAPED_OUT}")
list(GET ESCAPED_LINES 1 ESCAPED_ROW)
string(REPLACE "\"" "\"\"" ESCAPED_CSV_PATH "${ESCAPED_DB}")
set(EXPECTED_CSV_FIELD "\"${ESCAPED_CSV_PATH}\"")
string(FIND "${ESCAPED_ROW}" "${EXPECTED_CSV_FIELD}" ESCAPED_CSV_FOUND)
if(ESCAPED_CSV_FOUND LESS 0)
  message(FATAL_ERROR "CSV path escaping failed: ${ESCAPED_ROW}")
endif()
string(REPLACE "\"" "\\\"" ESCAPED_JSON_PATH "${ESCAPED_DB}")
string(FIND "${ESCAPED_JSON}" "${ESCAPED_JSON_PATH}" ESCAPED_JSON_FOUND)
if(ESCAPED_JSON_FOUND LESS 0)
  message(FATAL_ERROR "JSON path escaping failed: ${ESCAPED_JSON}")
endif()

string(ASCII 10 NEWLINE)
set(NEWLINE_DB "/tmp/cedar-query-bench-${TOKEN}-line${NEWLINE}path")
execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${NEWLINE_DB}"
  "--operation=state-at" "--duration-seconds=1" "--reopen-verify=true"
  OUTPUT_VARIABLE NEWLINE_OUT ERROR_VARIABLE NEWLINE_JSON RESULT_VARIABLE NEWLINE_RC)
if(NOT NEWLINE_RC EQUAL 0)
  message(FATAL_ERROR "newline path benchmark failed: ${NEWLINE_JSON}\n${NEWLINE_OUT}")
endif()
string(FIND "${NEWLINE_JSON}" "\\n" NEWLINE_JSON_FOUND)
if(NEWLINE_JSON_FOUND LESS 0)
  message(FATAL_ERROR "JSON newline escaping failed: ${NEWLINE_JSON}")
endif()
