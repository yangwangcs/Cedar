if(NOT DEFINED CEDAR_BENCHMARK)
  message(FATAL_ERROR "CEDAR_BENCHMARK is required")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789 TOKEN)
foreach(OP state-at expand-out earliest-arrival)
  set(DB "/tmp/cedar-query-bench-${TOKEN}-${OP}")
  set(EXTRA "")
  if(OP STREQUAL "expand-out")
    set(EXTRA "--projection-work=active")
  endif()
  execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${DB}" "--operation=${OP}" "--degree=1" "--selectivity-percent=1" "--readers=1" "--cache-state=cold" "--duration-seconds=1" "--reopen-verify=true" ${EXTRA} RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "query benchmark ${OP} failed: ${ERR}\n${OUT}")
  endif()
  string(REPLACE "\n" ";" LINES "${OUT}")
  list(GET LINES 0 HEADER)
  list(GET LINES 1 ROW)
  string(FIND "${HEADER}" "transactions_per_second" FOUND)
  if(FOUND LESS 0)
    message(FATAL_ERROR "CSV missing transactions_per_second: ${HEADER}")
  endif()
  string(FIND "${HEADER}" "query_qps" QPS_FOUND)
  if(QPS_FOUND LESS 0)
    message(FATAL_ERROR "CSV missing query_qps: ${HEADER}")
  endif()
  string(FIND "${HEADER}" "reopen_verified" REOPEN_FOUND)
  if(REOPEN_FOUND LESS 0 OR NOT ROW MATCHES ",true,pass,true$")
    message(FATAL_ERROR "CSV hard gate/reopen contract failed for ${OP}: ${ROW}")
  endif()
endforeach()
