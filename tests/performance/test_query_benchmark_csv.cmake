if(NOT DEFINED CEDAR_BENCHMARK)
  message(FATAL_ERROR "CEDAR_BENCHMARK is required")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789 TOKEN)
set(DB "/tmp/cedar-query-bench-${TOKEN}")
execute_process(COMMAND "${CEDAR_BENCHMARK}" "--path=${DB}" "--operation=state-at" "--degree=1" "--selectivity-percent=1" "--readers=1" "--cache-state=cold" "--duration-seconds=1" "--reopen-verify=true" RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT RC EQUAL 0)
  message(FATAL_ERROR "query benchmark failed: ${ERR}\n${OUT}")
endif()
string(REPLACE "\n" ";" LINES "${OUT}")
list(GET LINES 0 HEADER)
list(GET LINES 1 ROW)
string(FIND "${HEADER}" "transactions_per_second" FOUND)
if(FOUND LESS 0)
  message(FATAL_ERROR "CSV missing transactions_per_second: ${HEADER}")
endif()
